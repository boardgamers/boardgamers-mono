{
	"name": "@bgs/admin",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-fast-check -p ./tsconfig.json",
		"lint": "eslint .",
		"format": "oxfmt . && prettier --write \"src/**/*.svelte\""
	},
	"dependencies": {
		"dompurify": "^2.5.8",
		"marked": "^15.0.0"
	},
	"devDependencies": {
		"@alasano/svelte-fast-check": "0.4.6-fork.2",
		"@bgs/models": "workspace:*",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/typography": "^0.5.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/dompurify": "^2.4.0",
		"@typescript-eslint/eslint-plugin": "^8.32.1",
		"@typescript-eslint/parser": "^8.32.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^10.0.0",
		"eslint-plugin-svelte": "^3.0.0",
		"oxfmt": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:",
		"svelte": "^5.0.0",
		"svelte-check": "4.7.4",
		"tailwindcss": "^4.0.0",
		"typescript": "~6.0.3",
		"vite": "^6.0.0"
	},
	"lint-staged": {
		"*.{ts,svelte}": [
			"oxfmt",
			"eslint --fix"
		],
		"*.svelte": "prettier --write"
	}
}
