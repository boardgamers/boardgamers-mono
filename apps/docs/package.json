{
	"name": "@bgs/docs",
	"version": "1.0.0",
	"private": true,
	"description": "Self-hosted docs for the boardgamers ecosystem (markdown + HTML, agent-friendly)",
	"type": "module",
	"scripts": {
		"dev": "node --watch server.ts",
		"start": "node server.ts",
		"build": "tsc --noEmit",
		"tsc": "tsc --noEmit",
		"test": "node --test server.spec.ts",
		"lint": "oxlint",
		"lint-check": "oxlint",
		"fmt": "oxfmt",
		"fmt-check": "oxfmt --check"
	},
	"dependencies": {
		"marked": "^15.0.0"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "^1.51.0",
		"typescript": "catalog:"
	},
	"lint-staged": {
		"*.ts": [
			"oxfmt",
			"oxlint --fix"
		]
	}
}
