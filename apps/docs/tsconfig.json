{
	"compilerOptions": {
		"target": "es2024",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"strict": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["app/**/*.ts", "server.ts"],
	"exclude": ["**/*.spec.ts"]
}
