upstream gaia_api {
  server 127.0.0.1:50801;
  keepalive 8;
}

upstream gaia_chat {
  server 127.0.0.1:50802;
  keepalive 8;
}

upstream gaia_game_server {
  server 127.0.0.1:50803;
  keepalive 8;
}

upstream gaia_resources {
  server 127.0.0.1:50804;
  keepalive 8;
}

upstream gaia_front {
  server 127.0.0.1:8612;
  keepalive 8;
}

server {
  listen 80 http2;
  listen [::]:80 http2;

  root /home/coyotte508/code/gaia-site/front/dist;

  # Stale example only — NOT the live vhost. The canonical host is the apex
  # (boardgamers.space; www redirects there), and the real config lives on the
  # prod box. See #153.
  server_name www.boardgamers.space;

  # Compression of proxied responses (SSR HTML, admin SPA, API JSON) is handled
  # at the http level on the prod box: /etc/nginx/nginx.conf has `gzip on` and
  # — the critical part — `gzip_proxied any` (issue #127). Without gzip_proxied,
  # nginx refuses to gzip responses that come from a proxy upstream. No
  # per-vhost gzip block is needed (and adding one would collide with the
  # http-level directives as "duplicate").

  index index.html;

  location / {
    try_files $uri $uri/ @front;
  }

  location /api/gameplay {
    try_files $uri $uri/ @proxy_game_server;
  }

  location /resources {
    try_files $uri $uri/ @resources;
  }

  location /api {
    try_files $uri $uri/ @proxy;
  }

  location /ws {
    proxy_pass http://gaia_chat;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "Upgrade";
    # MUST be set on the live vhost too: the default proxy_read_timeout (60s) kills an
    # idle websocket (e.g. a backgrounded mobile tab) without a close frame, so the client
    # never learns the socket died and never reconnects — chat then stays empty. Keep the
    # connection open well beyond the client's 30s ping. The client now also detects a
    # silently-dead socket via an application-level ping/pong and reconnects on its own.
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location @static {
    try_files $uri /index.html =502;
  }

  location @proxy {
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $http_host;
    proxy_set_header X-NginX-Proxy true;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_pass http://gaia_api;
    proxy_redirect off;
  }

  location @resources {
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $http_host;
    proxy_set_header X-NginX-Proxy true;
    proxy_set_header X-Forwarded-Proto $scheme;

    // Rewrite url to remove "/resources" prefix
    rewrite ^/resources/(.*) /$1 break;

    proxy_pass http://gaia_resources;
    proxy_redirect off;
  }

  location @proxy_game_server {
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $http_host;
    proxy_set_header X-NginX-Proxy true;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_pass http://gaia_game_server;
    proxy_redirect off;
  }

  location @front {
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $http_host;
    proxy_set_header X-NginX-Proxy true;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_pass http://gaia_front;
    proxy_redirect off;

    error_page 502 = @static;
  }
}


server {
  listen 80 http2;
  listen [::]:80 http2;

  root /home/coyotte508/code/gaia-site/front/dist;

  server_name resources.boardgamers.space;

  index index.html;

  location / {
    try_files $uri $uri/ @front;
  }

  location @static {
    try_files $uri /index.html =502;
  }

  location @front {
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host localhost;
    proxy_set_header X-NginX-Proxy true;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_pass http://gaia_resources;
    proxy_redirect off;

    error_page 502 = @static;
  }
}
