# API server — copy to `.env` and adjust. `.env` is gitignored (local-only).
# Every var is optional: app/config/env.ts has dev defaults for all of them.
# The one you almost always want to set locally is dbUrl.

# --- Database ---------------------------------------------------------------
# Local mongo from the root docker-compose.yml (`podman compose up -d`).
# `replicaSet` + `directConnection` are required: the container initiates its
# replica set with member host "localhost", so the driver must not re-resolve
# the host via the RS config (it would fail / pick the wrong address).
dbUrl=mongodb://127.0.0.1:27517/admin?replicaSet=rs0&directConnection=true
# Base database name; "-dev" / "-test" is appended automatically outside production.
# Per agent-worktree instances: set e.g. dbName=bgs-<name> to isolate the db.
#dbName=bgs

# --- Network ----------------------------------------------------------------
#port=50801            # HTTP API
#wsPort=50802          # websocket
#resourcesPort=50804
#listenHost=127.0.0.1  # agent worktrees set this to their allocated 127.1.X.Y
#webAppUrl=http://localhost:8612
#domain=boardgamers.space

# --- Auth / JWT -------------------------------------------------------------
#sessionSecret=...     # session cookie signature (dev has a built-in default)
#jwtSecret=...         # HS256 secret (dev default); jwtMode=asymmetric switches to RS256 keys
#jwtMode=asymmetric    # reads app/config/private.key + public.pem

# --- Features (dev defaults are fine) ---------------------------------------
#cron=true             # false on PM2 workers; the single dev process needs it on
# Auto-drop inactive players / auto-cancel stalled games (#94), hourly sweep.
#autoCancelLiveThresholdSec=86400   # games with timePerGame ≤ this are "live" — never dropped, only cancelled
#autoCancelLiveIdleMs=259200000     # live game with no move for this long is cancelled outright (3d)
#autoCancelGraceMs=259200000        # how long a current player's deadline may be expired (3d)
#autoCancelMinIdleMs=604800000      # never touch an async game with a move this recent (7d)
#autoCancelMinAgeMs=1209600000      # async games younger than this are never cancelled, only dropped (14d)
#inviteOnly=false
#maxOpenGamesPerUser=10
#authRateLimitWindowMs=60000   # window for auth-endpoint rate limiting (#195)
#authRateLimitMaxPerIp=10      # attempts per IP (bucket) per window on login/forget/reset/confirm/signup
#cleanupDeadUsers=off  # "dry-run" then "delete" for the dead-account archiver
#lokiUrl=http://127.0.0.1:3100

# --- OAuth2 issuer (production only) ----------------------------------------
#oauth2Issuer=https://boardgamers.space
# Comma-separated CIMD client_id URLs of first-party trusted clients: they skip
# the consent screen for every user. Defaults to the forum + Grafana.
#trustedOauthClients=https://forum.boardgamers.space/client-metadata.json,https://grafana.boardgamers.space/client-metadata.json

# --- Mail (Mailgun) ----------------------------------------------------------
#mailingApiKey=...
#mailingHost=api.eu.mailgun.net
#emailDomain=mg.boardgamers.space
#newsletterDomain=newsletter.boardgamers.space
#automatedEmails=false
#authEmailCooldownMs=900000  # min interval between auth emails (reset/confirm) to one address

# --- Social login ------------------------------------------------------------
#discordId= / #discordSecret=
#facebookId= / #facebookSecret=
#googleId= / #googleSecret=
#githubId=            # PKCE public client, no secret

# --- S3 avatar storage + game bundles (optional) ------------------------------
# When S3_BUCKET + S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY are all set, uploaded
# avatars are written S3-only (the mongo doc keeps metadata + the etag hash, no
# blob) and served as 302 redirects to the public object URL; existing mongo
# blobs stay as fallback. Unset = mongo serving, exactly as before.
# The same bucket also stores admin-uploaded game bundles (#268): viewer
# JS/CSS and engine npm-pack tarballs under `games/<game>/<version>/…`
# (see POST /api/admin/gameinfo/:game/:version/viewer/file|engine).
# Avatars and game bundles are public-read objects (no presigning): the avatar
# redirect target and the bundle URLs injected into game iframes / passed to
# the game-server's `npm install <url>` all need anonymous GET. S3_ENDPOINT is
# what the api talks to for writes; S3_PUBLIC_ENDPOINT is the public base
# browsers are redirected to (defaults to S3_ENDPOINT — right when the gateway
# is public, e.g. Scaleway).
# Envs WITHOUT creds but WITH S3_BUCKET + S3_PUBLIC_ENDPOINT (PR previews) can't
# upload/migrate but still 302 migrated avatars to the public gateway
# (anonymous GET works).
# If the store rejects per-object ACLs, apply a bucket policy allowing anonymous
# s3:GetObject on `avatars/*` AND `games/*` ONLY (the bucket also holds private
# `share/*`) — plus the owning key's full s3:* statement (ALLOW-only policy).
# Local dev (root docker-compose.yml MinIO):
# S3_BUCKET=bgs-assets
# S3_REGION=us-east-1
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY_ID=minio
# S3_SECRET_ACCESS_KEY=minio123
# Prod (Scaleway):
# S3_BUCKET=bgs-assets
# S3_REGION=fr-par
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_PUBLIC_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
