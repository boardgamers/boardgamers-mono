server {
    server_name grafana.boardgamers.space;

    # CIMD client metadata for the boardgamers.space OAuth2/OIDC provider: it fetches
    # this URL (it's the client_id) to learn Grafana's redirect_uri/scopes. Keep in
    # sync with the GF_AUTH_GENERIC_OAUTH_* envs in docker-compose.yml.
    location = /client-metadata.json {
        default_type application/json;
        return 200 '{"client_id":"https://grafana.boardgamers.space/client-metadata.json","client_name":"Grafana","redirect_uris":["https://grafana.boardgamers.space/login/generic_oauth"],"grant_types":["authorization_code"],"response_types":["code"],"token_endpoint_auth_method":"none","scope":"openid profile email role"}';
    }

    location / {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://127.0.0.1:3030;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/grafana.boardgamers.space/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/grafana.boardgamers.space/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}server {
    if ($host = grafana.boardgamers.space) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name grafana.boardgamers.space;
    return 404; # managed by Certbot


}
